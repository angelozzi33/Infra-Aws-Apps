<?xml version="1.0" encoding="utf-8"?>
<!--
  Fontes de pacotes das aplicações (ADR-026).
  - "infra-aws": biblioteca da plataforma no GitHub Packages. O GitHub Packages exige autenticação
    até para leitura: no Actions usamos o GITHUB_TOKEN; no seu computador, um token pessoal com
    read:packages (veja o README).
  - packageSourceMapping: pacotes Marutech.* só vêm do GitHub; o resto só do nuget.org. Isso impede
    que um pacote homônimo publicado no nuget.org seja usado no lugar do nosso (dependency confusion).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="infra-aws" value="https://nuget.pkg.github.com/angelozzi33/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="infra-aws">
      <package pattern="Marutech.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
